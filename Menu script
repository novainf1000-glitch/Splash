    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -20, 1, 0)
    searchBox.Position = UDim2.new(0, 10, 0, 0)
    searchBox.BackgroundTransparency = 1
    searchBox.Text = ""
    searchBox.PlaceholderText = "Search Script..."
    searchBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
    searchBox.TextColor3 = WHITE
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextSize = 12
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = searchFrame

    local counter = Instance.new("TextLabel")
    counter.Size = UDim2.new(0, 100, 0, 20)
    counter.Position = UDim2.new(1, -105, 0, 4)
    counter.BackgroundTransparency = 1
    counter.Text = "Scripts: 0"
    counter.TextColor3 = WHITE
    counter.Font = Enum.Font.GothamBold
    counter.TextSize = 11
    counter.TextXAlignment = Enum.TextXAlignment.Right
    counter.Parent = tab

    local gridScroll = Instance.new("ScrollingFrame")
    gridScroll.Size = UDim2.new(1, -10, 1, -42)
    gridScroll.Position = UDim2.new(0, 5, 0, 38)
    gridScroll.BackgroundTransparency = 1
    gridScroll.BorderSizePixel = 0
    gridScroll.ScrollBarThickness = 5
    gridScroll.ScrollBarImageColor3 = WHITE
    gridScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    gridScroll.Parent = tab

    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 90, 0, 45)
    grid.CellPadding = UDim2.new(0, 5, 0, 5)
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = gridScroll

    grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        gridScroll.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 10)
    end)

    local scriptBtns = {}

    local function refreshCounter()
        counter.Text = "Scripts: " .. #scriptBtns
    end

    local function filterScripts(filter)
        filter = (filter or ""):lower()
        for _, item in pairs(scriptBtns) do
            local match = filter == "" or item.data.name:lower():find(filter)
            item.btn.Visible = match
        end
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        filterScripts(searchBox.Text)
    end)

    local function createScriptBtn(data)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 90, 0, 45)
        b.BackgroundColor3 = BLACK
        b.Text = data.name
        b.TextColor3 = WHITE
        b.Font = Enum.Font.GothamBold
        b.TextSize = 10
        b.TextWrapped = true
        b.AutoButtonColor = false
        b.BorderSizePixel = 0
        b.Parent = gridScroll
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        addWhiteStroke(b, 1)

        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 16, 0, 16)
        delBtn.Position = UDim2.new(1, -18, 0, 2)
        delBtn.BackgroundColor3 = BLACK
        delBtn.Text = "x"
        delBtn.TextColor3 = WHITE
        delBtn.Font = Enum.Font.GothamBold
        delBtn.TextSize = 10
        delBtn.AutoButtonColor = false
        delBtn.BorderSizePixel = 0
        delBtn.Parent = b
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(1, 0)
        addWhiteStroke(delBtn, 1)

        b.MouseButton1Click:Connect(function()
            local ok, err = pcall(function()
                loadstring(game:HttpGet(data.url))()
            end)
            if not ok then
                StarterGui:SetCore("SendNotification", {
                    Title = "Load Error",
                    Text = "Failed: " .. tostring(err),
                    Duration = 5
                })
            end
        end)

        delBtn.MouseButton1Click:Connect(function()
            CloudRemoveByName(data.name)
            b:Destroy()
            for i, item in pairs(scriptBtns) do
                if item.btn == b then
                    table.remove(scriptBtns, i)
                    break
                end
            end
            refreshCounter()
        end)

        b.MouseEnter:Connect(function()
            b.BackgroundColor3 = MIDGRAY
        end)
        b.MouseLeave:Connect(function()
            b.BackgroundColor3 = BLACK
        end)

        table.insert(scriptBtns, {btn = b, data = data})
        return b
    end

    local addBtn = Instance.new("TextButton")
    addBtn.Size = UDim2.new(0, 90, 0, 45)
    addBtn.BackgroundColor3 = BLACK
    addBtn.Text = "Add Script"
    addBtn.TextColor3 = WHITE
    addBtn.Font = Enum.Font.GothamBold
    addBtn.TextSize = 11
    addBtn.AutoButtonColor = false
    addBtn.BorderSizePixel = 0
    addBtn.Parent = gridScroll
    Instance.new("UICorner", addBtn).CornerRadius = UDim.new(0, 6)
    addWhiteStroke(addBtn, 1.5)

    addBtn.MouseEnter:Connect(function()
        addBtn.BackgroundColor3 = MIDGRAY
    end)
    addBtn.MouseLeave:Connect(function()
        addBtn.BackgroundColor3 = BLACK
    end)

    return {
        tab = tab,
        searchBox = searchBox,
        addBtn = addBtn,
        gridScroll = gridScroll,
        scriptBtns = scriptBtns,
        createScriptBtn = createScriptBtn,
        refreshCounter = refreshCounter,
        filterScripts = filterScripts
    }
end

