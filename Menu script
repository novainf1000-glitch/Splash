-- HAM ANIMATION
local function getAnimator()
    if not hum then return nil end
    local a = hum:FindFirstChildOfClass("Animator")
    if not a then a = Instance.new("Animator") a.Parent = hum end
    return a
end

local function LoadTrack(id)
    local a = getAnimator()
    if not a then return nil end
    if CurrentTrack then pcall(function() CurrentTrack:Stop(0) end) CurrentTrack = nil end
    local animId = "rbxassetid://" .. tostring(id)
    local ok, result = pcall(function() return game:GetObjects(animId) end)
    if ok and result and #result > 0 and result[1]:IsA("Animation") then
        animId = result[1].AnimationId
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    local ok2, track = pcall(function() return a:LoadAnimation(anim) end)
    if not ok2 or not track then return nil end
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = false
    pcall(function() track:Play(0.1, 1, Settings.Speed) end)
    CurrentTrack = track
    return track
end

local function StopTrack()
    if CurrentTrack then pcall(function() CurrentTrack:Stop(0.1) end) CurrentTrack = nil end
    IsPlaying = false
end

-- CLOUD SYNC
local CloudData = {}

local function CloudFetch()
    if not game:HttpGet then return {} end
    local ok, result = pcall(function()
        return game:HttpGet(NPOINT_URL)
    end)
    if ok and result then
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(result) end)
        if decodeOk and type(data) == "table" then
            CloudData = data
            return data
        end
    end
    return {}
end

local function CloudSave()
    if not game:HttpPost then return false end
    local payload = HttpService:JSONEncode(CloudData)
    local ok = pcall(function()
        game:HttpPost(NPOINT_URL, payload, true, {
            ["Content-Type"] = "application/json"
        })
    end)
    return ok
end

local function CloudAdd(name, url, category)
    table.insert(CloudData, {
        name = name,
        url = url,
        category = category,
        author = "user"
    })
    return CloudSave()
end

local function CloudRemove(index)
    if CloudData[index] then
        table.remove(CloudData, index)
        return CloudSave()
    end
    return false
end

