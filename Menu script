local function getDeviceType()
    local ok, result = pcall(function()
        if UIS.TouchEnabled and not UIS.KeyboardEnabled then
            if workspace.CurrentCamera then
                local vp = workspace.CurrentCamera.ViewportSize
                if vp.X >= 1024 or vp.Y >= 768 then return "Tablet" end
            end
            return "Mobile"
        elseif UIS.KeyboardEnabled and UIS.MouseEnabled then
            return "Desktop"
        end
        return "Unknown"
    end)
    if ok and result then return result end
    return "Unknown"
end

local function getPlatform()
    local ok, result = pcall(function()
        if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "Android/iOS" end
        if UIS.KeyboardEnabled then return "PC" end
        return "Unknown"
    end)
    if ok and result then return result end
    return "Unknown"
end

local function getExecutor()
    local ok, name = pcall(function()
        if syn then return "Synapse X" end
        if KRNL_LOADED then return "Krnl" end
        if fluxus then return "Fluxus" end
        if Delta then return "Delta" end
        if isElectron then return "Electron" end
        if identifyexecutor and type(identifyexecutor) == "function" then
            return identifyexecutor()
        end
        return "Unknown"
    end)
    if ok and name then return name end
    return "Unknown"
end

local PlayerInfo = {
    DisplayName = player.DisplayName or "Unknown",
    Username = player.Name or "Unknown",
    UserId = tostring(player.UserId or 0),
    AccountAge = tostring(player.AccountAge or 0) .. " days",
    JoinDate = os.date("%B %d, %Y", os.time() - (player.AccountAge or 0) * 86400),
    Membership = tostring(player.MembershipType or "None"):gsub("Enum.MembershipType.", ""),
    Executor = getExecutor(),
    Platform = getPlatform(),
    Device = getDeviceType(),
}

local CloudData = {}

local function CloudFetch()
    if type(game.HttpGet) ~= "function" then return {} end
    local ok, result = pcall(function()
        return game:HttpGet(NPOINT_URL)
    end)
    if ok and result then
        local decodeOk, data = pcall(function() return HttpService:JSONDecode(result) end)
        if decodeOk and type(data) == "table" then
            CloudData = data
            return data
        end
    end
    return {}
end

local function CloudSave()
    if type(game.HttpPost) ~= "function" then return false end
    local payload = HttpService:JSONEncode(CloudData)
    local ok = pcall(function()
        game:HttpPost(NPOINT_URL, payload, true, {
            ["Content-Type"] = "application/json"
        })
    end)
    return ok
end

local function CloudAdd(name, url, category)
    table.insert(CloudData, {
        name = name,
        url = url,
        category = category,
        author = "user"
    })
    return CloudSave()
end

local function CloudRemoveByName(targetName)
    for i = #CloudData, 1, -1 do
        if CloudData[i].name == targetName then
            table.remove(CloudData, i)
        end
    end
    return CloudSave()
end

