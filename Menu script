Instance.new("UICorner", cancelBtn).CornerRadius = UDim.new(0, 6)

local createBtn = Instance.new("TextButton")
createBtn.Size = UDim2.new(0.45, 0, 0, 32)
createBtn.Position = UDim2.new(0.55, 0, 0, 170)
createBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 60)
createBtn.Text = "Create"
createBtn.TextColor3 = Color3.new(1, 1, 1)
createBtn.Font = Enum.Font.GothamBold
createBtn.TextSize = 12
createBtn.AutoButtonColor = false
createBtn.BorderSizePixel = 0
createBtn.ZIndex = 11
createBtn.Parent = formFrame
Instance.new("UICorner", createBtn).CornerRadius = UDim.new(0, 6)

local function openForm()
    formFrame.Visible = true
    nameInput.Text = ""
    urlInput.Text = ""
    selectedCategory = "Main"
    mainCatBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 100)
    otherCatBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
end

local function closeForm()
    formFrame.Visible = false
end

cancelBtn.MouseButton1Click:Connect(closeForm)

mainGrid.addBtn.MouseButton1Click:Connect(openForm)
otherGrid.addBtn.MouseButton1Click:Connect(openForm)

createBtn.MouseButton1Click:Connect(function()
    local name = nameInput.Text
    local url = urlInput.Text
    local category = selectedCategory

    if name == "" or url == "" then
        StarterGui:SetCore("SendNotification", {
            Title = "Error",
            Text = "Please fill Name and URL",
            Duration = 3
        })
        return
    end

    local success = CloudAdd(name, url, category)

    if success then
        local target = (category == "Main") and mainGrid or otherGrid
        local data = {name = name, url = url, category = category}
        target.createScriptBtn(data)
        target.refreshCounter()

        StarterGui:SetCore("SendNotification", {
            Title = "Success",
            Text = "Script added!",
            Duration = 3
        })

        closeForm()
    else
        StarterGui:SetCore("SendNotification", {
            Title = "Error",
            Text = "Failed to save",
            Duration = 3
        })
    end
end)

-- LOAD CLOUD
task.spawn(function()
    local data = CloudFetch()

    if data and #data > 0 then
        for i, item in ipairs(data) do
            if item.name and item.url and item.category then
                local target = (item.category == "Main") and mainGrid or otherGrid
                target.createScriptBtn(item)
            end
        end
        mainGrid.refreshCounter()
        otherGrid.refreshCounter()

        StarterGui:SetCore("SendNotification", {
            Title = "Cloud Loaded",
            Text = #data .. " scripts",
            Duration = 3
        })
    end
end)
