local function openForm()
    formFrame.Visible = true
    nameInput.Text = ""
    urlInput.Text = ""
    selectedCategory = "Main"
    mainCatBtn.BackgroundColor3 = MIDGRAY
    otherCatBtn.BackgroundColor3 = BLACK
end

local function closeForm()
    formFrame.Visible = false
end

cancelBtn.MouseButton1Click:Connect(closeForm)

mainGrid.addBtn.MouseButton1Click:Connect(openForm)
otherGrid.addBtn.MouseButton1Click:Connect(openForm)

createBtn.MouseButton1Click:Connect(function()
    local name = nameInput.Text
    local url = urlInput.Text
    local category = selectedCategory

    if name == "" or url == "" then
        StarterGui:SetCore("SendNotification", {
            Title = "Error",
            Text = "Please fill Name and URL",
            Duration = 3
        })
        return
    end

    local success = CloudAdd(name, url, category)

    if success then
        local target = (category == "Main") and mainGrid or otherGrid
        local data = {name = name, url = url, category = category}
        target.createScriptBtn(data)
        target.refreshCounter()

        StarterGui:SetCore("SendNotification", {
            Title = "Success",
            Text = "Script added!",
            Duration = 3
        })

        closeForm()
    else
        StarterGui:SetCore("SendNotification", {
            Title = "Error",
            Text = "Failed to save",
            Duration = 3
        })
    end
end)

-- LOAD CLOUD
task.spawn(function()
    local data = CloudFetch()

    if data and #data > 0 then
        for i, item in ipairs(data) do
            if item.name and item.url and item.category then
                local target = (item.category == "Main") and mainGrid or otherGrid
                target.createScriptBtn(item)
            end
        end
        mainGrid.refreshCounter()
        otherGrid.refreshCounter()

        StarterGui:SetCore("SendNotification", {
            Title = "Cloud Loaded",
            Text = #data .. " scripts",
            Duration = 3
        })
    end
end)
