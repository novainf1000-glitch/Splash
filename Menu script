-- Tab System
local tabs = {}
local currentTab = nil

local function createTab(id, name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.BackgroundColor3 = BLACK
    btn.Text = name
    btn.TextColor3 = WHITE
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local stroke = addWhiteStroke(btn, 1)

    local cf = Instance.new("Frame")
    cf.Size = UDim2.new(1, -10, 1, -10)
    cf.Position = UDim2.new(0, 5, 0, 5)
    cf.BackgroundTransparency = 1
    cf.Visible = false
    cf.Parent = content

    tabs[id] = {btn = btn, content = cf, stroke = stroke}

    btn.MouseButton1Click:Connect(function()
        for tid, t in pairs(tabs) do
            t.btn.BackgroundColor3 = BLACK
            t.content.Visible = false
            t.stroke.Color = WHITE
            t.stroke.Thickness = 1
        end
        btn.BackgroundColor3 = MIDGRAY
        cf.Visible = true
        stroke.Thickness = 2
        currentTab = id
    end)

    if not currentTab then
        btn.BackgroundColor3 = MIDGRAY
        cf.Visible = true
        stroke.Thickness = 2
        currentTab = id
    end

    return cf
end

