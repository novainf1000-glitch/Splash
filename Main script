-- Kéo CONTAINER (cả cụm di chuyển)
local cDrag = false
local cs_, cp_
container.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        cDrag = true
        cs_ = i.Position
        cp_ = container.Position
        local conn
        conn = i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then
                cDrag = false
                if conn then conn:Disconnect() end
            end
        end)
    end
end)
UIS.InputChanged:Connect(function(i)
    if cDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - cs_
        container.Position = UDim2.new(cp_.X.Scale, cp_.X.Offset + d.X, cp_.Y.Scale, cp_.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        cDrag = false
    end
end)

-- Hàm tạo nút (không kéo, chỉ bấm)
local function createBtn(name, id, yPos)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -10, 0, 30)
    b.Position = UDim2.new(0, 5, 0, yPos)
    b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    b.Text = name
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = container
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    b.MouseEnter:Connect(function()
        if ActiveButton ~= b then
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end
    end)
    b.MouseLeave:Connect(function()
        if ActiveButton ~= b then
            b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        end
    end)

    b.MouseButton1Click:Connect(function()
        if ActiveButton == b and IsPlaying then
            StopTrack()
            ActiveButton = nil
            b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        else
            StopTrack()
            local tr = LoadTrack(id)
            if tr then
                IsPlaying = true
                ActiveButton = b
                b.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                tr.Stopped:Connect(function()
                    if ActiveButton == b then
                        IsPlaying = false
                        ActiveButton = nil
                        b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    end
                end)
            end
        end
    end)
    return b
end

