local cDrag = false
local cs_, cp_
container.InputBegan:Connect(function(i)
    if Settings.Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        cDrag = true
        cs_ = i.Position
        cp_ = container.Position
        local conn
        conn = i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then
                cDrag = false
                if conn then conn:Disconnect() end
            end
        end)
    end
end)
UIS.InputChanged:Connect(function(i)
    if not cDrag then return end
    if Settings.Locked then cDrag = false return end
    if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
        local d = i.Position - cs_
        container.Position = UDim2.new(cp_.X.Scale, cp_.X.Offset + d.X, cp_.Y.Scale, cp_.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        cDrag = false
    end
end)

local allBtns = {}
local markedBtns = {}

local function createBtn(name, id)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, Settings.BtnSize * 2.8)
    f.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    f.BorderSizePixel = 0
    f.Parent = container
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    local redStroke = Instance.new("UIStroke")
    redStroke.Color = Color3.fromRGB(255, 50, 50)
    redStroke.Thickness = 2
    redStroke.Enabled = false
    redStroke.Name = "RedStroke"
    redStroke.Parent = f

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    b.Text = name
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = math.max(8, Settings.BtnSize)
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = f
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local xMark = Instance.new("TextLabel")
    xMark.Size = UDim2.new(1, 0, 1, 0)
    xMark.BackgroundTransparency = 1
    xMark.Text = "X"
    xMark.TextColor3 = Color3.fromRGB(255, 50, 50)
    xMark.TextStrokeTransparency = 0
    xMark.TextStrokeColor3 = Color3.new(0, 0, 0)
    xMark.Font = Enum.Font.GothamBold
    xMark.TextSize = 20
    xMark.Visible = false
    xMark.Name = "XMark"
    xMark.ZIndex = 5
    xMark.Parent = f

    local marked = false

    b.MouseEnter:Connect(function()
        if not Settings.DeleteMode and ActiveButton ~= b then
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end
    end)
    b.MouseLeave:Connect(function()
        if not Settings.DeleteMode and ActiveButton ~= b then
            b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        end
    end)

    b.MouseButton1Click:Connect(function()
        if Settings.DeleteMode then
            marked = not marked
            xMark.Visible = marked
            if marked then
                local exists = false
                for _, m in pairs(markedBtns) do
                    if m == f then exists = true break end
                end
                if not exists then table.insert(markedBtns, f) end
            else
                for i, m in pairs(markedBtns) do
                    if m == f then table.remove(markedBtns, i) break end
                end
            end
            return
        end

        if ActiveButton == b and IsPlaying then
            StopTrack()
            ActiveButton = nil
            b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        else
            StopTrack()
            local tr = LoadTrack(id)
            if tr then
                IsPlaying = true
                ActiveButton = b
                b.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                tr.Stopped:Connect(function()
                    if ActiveButton == b then
                        IsPlaying = false
                        ActiveButton = nil
                        b.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    end
                end)
            end
        end
    end)

    table.insert(allBtns, {frame = f, btn = b, name = name, id = id})
    return b
end

