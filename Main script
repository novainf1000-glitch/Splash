local function getAnimator()
    if not hum then return nil end
    local a = hum:FindFirstChildOfClass("Animator")
    if not a then a = Instance.new("Animator") a.Parent = hum end
    return a
end

local function getAnimId(id)
    if idCache[id] then return idCache[id] end
    local animId = "rbxassetid://" .. tostring(id)
    local ok, result = pcall(function() return game:GetObjects(animId) end)
    if ok and result and #result > 0 and result[1]:IsA("Animation") then
        animId = result[1].AnimationId
    end
    idCache[id] = animId
    return animId
end

local function LoadTrack(id)
    local a = getAnimator()
    if not a then return nil end
    if CurrentTrack then pcall(function() CurrentTrack:Stop(0) end) CurrentTrack = nil end
    local animId = getAnimId(id)
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    local ok2, track = pcall(function() return a:LoadAnimation(anim) end)
    if not ok2 or not track then return nil end
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = false
    pcall(function() track:Play(0.1, 1, Settings.Speed) end)
    CurrentTrack = track
    return track
end

local function StopTrack()
    if CurrentTrack then pcall(function() CurrentTrack:Stop(0.1) end) CurrentTrack = nil end
    IsPlaying = false
end

local AFLConn = nil
local function AFStart()
    if AFLConn then return end
    AFLConn = RunService.Heartbeat:Connect(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local o = p.Character:FindFirstChild("HumanoidRootPart")
                if o then pcall(function()
                    o.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
                    o.Velocity = Vector3.new(0, o.Velocity.Y, 0)
                    o.RotVelocity = Vector3.new(0,0,0)
                end) end
            end
        end
    end)
end
local function AFStop()
    if AFLConn then AFLConn:Disconnect() AFLConn = nil end
end

