    b.BackgroundColor3 = Color3.new(0,0,0)
    b.Text = tBtn(key)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = f
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    local xMark = Instance.new("TextLabel")
    xMark.Size = UDim2.new(1,0,1,0)
    xMark.BackgroundTransparency = 1
    xMark.Text = "✕"
    xMark.TextColor3 = Color3.fromRGB(255, 50, 50)
    xMark.TextStrokeTransparency = 0
    xMark.TextStrokeColor3 = Color3.new(0,0,0)
    xMark.Font = Enum.Font.GothamBold
    xMark.TextSize = 20
    xMark.Visible = false
    xMark.Name = "XMark"
    xMark.ZIndex = 5
    xMark.Parent = f
    local isClick = makeDrag(b, f, true)
    local marked = false
    b.MouseButton1Click:Connect(function()
        if Settings.DeleteMode then
            marked = not marked
            xMark.Visible = marked
            if marked then
                local exists = false
                for _, m in pairs(markedBtns) do
                    if m == f then exists = true break end
                end
                if not exists then table.insert(markedBtns, f) end
            else
                for i, m in pairs(markedBtns) do
                    if m == f then table.remove(markedBtns, i) break end
                end
            end
            return
        end
        if not isClick() then return end
        if ActiveButton == b and IsPlaying then
            StopTrack() ActiveButton = nil
            TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.new(0,0,0)}):Play()
        else
            StopTrack()
            local tr = LoadTrack(id)
            if tr then
                IsPlaying = true ActiveButton = b
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60,60,60)}):Play()
                tr.Stopped:Connect(function()
                    if ActiveButton == b then
                        IsPlaying = false ActiveButton = nil
                        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.new(0,0,0)}):Play()
                    end
                end)
            end
        end
    end)
    table.insert(allBtns, {frame = f, btn = b, key = key})
    return b
end

