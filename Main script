    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,6)

    local th = Instance.new("Frame")
    th.Size = UDim2.new(0, 16, 0, 16)
    th.AnchorPoint = Vector2.new(0.5, 0.5)
    th.Position = UDim2.new(rel0, 0, 0.5, 0)
    th.BackgroundColor3 = Color3.fromRGB(220,220,220)
    th.Parent = bar
    Instance.new("UICorner", th).CornerRadius = UDim.new(1,0)

    local drag = false
    local function set(v)
        v = math.clamp(v, min, max)
        lbl.Text = name .. ": " .. math.floor(v)
        local r = (v-min)/(max-min)
        fill.Size = UDim2.new(r, 0, 1, 0)
        th.Position = UDim2.new(r, 0, 0.5, 0)
        cb(v)
    end
    local function upd(i)
        local r = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        set(min + (max-min) * r)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true upd(i)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

