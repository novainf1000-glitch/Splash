local toggleRefs = {}
local function toggle(key, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.Text = t(key) .. ": " .. t("off")
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    local active = false
    b.MouseButton1Click:Connect(function()
        active = not active
        b.BackgroundColor3 = active and Color3.fromRGB(60,60,60) or Color3.fromRGB(40,40,40)
        b.Text = t(key) .. ": " .. (active and t("on") or t("off"))
        cb(b, active)
    end)
    toggleRefs[key] = {btn = b, isActive = function() return active end}
    return b
end

