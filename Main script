        b.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
    end)

    b.MouseButton1Click:Connect(function()
        if DanceTrack then
            pcall(function() DanceTrack:Stop(0) end)
            DanceTrack = nil
        end

        pcall(function()
            local animator = getAnimator()
            if not animator then return end

            local animId = "rbxassetid://" .. tostring(id)
            local ok, result = pcall(function() return game:GetObjects(animId) end)
            if ok and result and #result > 0 and result[1]:IsA("Animation") then
                animId = result[1].AnimationId
            end

            local anim = Instance.new("Animation")
            anim.AnimationId = animId
            DanceTrack = animator:LoadAnimation(anim)
            DanceTrack.Priority = Enum.AnimationPriority.Action4
            DanceTrack.Looped = true
            DanceTrack:Play(0.1)
        end)
    end)

    table.insert(danceBtns, f)
    return b
