    local c = player.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then
        h.CameraOffset = Vector3.new(1.75, 0.5, 0)
    end
    player.CameraMode = Enum.CameraMode.LockFirstPerson
end

