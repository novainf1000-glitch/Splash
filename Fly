-- ========== ANIMATION ==========
local function playCutAnim(animID)
    if not animID or animID == 0 then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    if State.AnimTrack then
        pcall(function() State.AnimTrack:Stop(0.1) end)
        State.AnimTrack = nil
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animID)
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok or not track then return end
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = false
    track:Play(0.1)
    State.AnimTrack = track
    task.spawn(function()
        while State.AnimTrack == track and State.Flying do
            task.wait(Config.SkipStart)
            if State.AnimTrack ~= track or not State.Flying then break end
            track.TimePosition = Config.SkipEnd
            task.wait()
            local remaining = (Config.TotalDuration - Config.SkipEnd) / Config.AnimSpeed
            task.wait(remaining)
            if State.AnimTrack ~= track or not State.Flying then break end
            track:Play(0.1)
        end
    end)
end

local function stopAnim()
    if State.AnimTrack then
        pcall(function() State.AnimTrack:Stop(0.2) end)
        State.AnimTrack = nil
    end
end

-- ========== FLY ==========
local function startFly(mode)
    if State.Flying then return end
    if not root then return end
    
    State.Flying = true
    State.Mode = mode or "Normal"
    State.SpeedUpTime = tick()
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    State.FlyBV = bv
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 10000
    bg.D = 500
    bg.CFrame = root.CFrame
    bg.Parent = root
    State.FlyBG = bg
    
    local animID = Config.NormalAnimID
    if State.Mode == "Dash" then
        animID = Config.DashAnimID
    elseif State.Mode == "Hover" then
        animID = Config.HoverAnimID
    elseif State.Mode == "SpeedFly" then
        animID = Config.SpeedFlyAnimID
    end
    if animID == 0 then
        animID = Config.FlyAnimID
    end
    
    playCutAnim(animID)
    notify("✈️", "Fly: " .. State.Mode)
end

local function stopFly()
    if not State.Flying then return end
    State.Flying = false
    State.Mode = "None"
    State.SpeedUpTime = nil
    if State.FlyBV then State.FlyBV:Destroy() State.FlyBV = nil end
    if State.FlyBG then State.FlyBG:Destroy() State.FlyBG = nil end
    stopAnim()
    notify("✈️", "Đã tắt")
end

local flyConn = nil

local function startFlyLoop()
    if flyConn then flyConn:Disconnect() end
    flyConn = RunService.RenderStepped:Connect(function()
        if not State.Flying then return end
        if not root or not hum then return end
        if hum.Health <= 0 then stopFly() return end
        
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.zero
        local camCF = cam.CFrame
        local rootCF = root.CFrame
        
        local forward, right, up
        if Config.FlyDirection == "Camera" then
            forward = camCF.LookVector
            right = camCF.RightVector
        else
            forward = rootCF.LookVector
            right = rootCF.RightVector
        end
        up = Vector3.new(0, 1, 0)
        
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + forward end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - forward end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + up end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - up end
        
        local speed = Config.FlySpeed
        if State.Mode == "SpeedFly" then
            if State.SpeedUpTime and tick() - State.SpeedUpTime > 2 then
                speed = Config.FastSpeed
            else
                speed = Config.SlowSpeed
            end
        end
        
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit * speed
        end
        State.FlyBV.Velocity = moveDir
        
        if Config.FlyDirection == "Character" and moveDir.Magnitude > 0 then
            local lookDir = Vector3.new(moveDir.X, 0, moveDir.Z)
            if lookDir.Magnitude > 0 then
                State.FlyBG.CFrame = CFrame.new(root.Position, root.Position + lookDir)
            end
        else
            State.FlyBG.CFrame = CFrame.new(root.Position, root.Position + camCF.LookVector)
        end
    end)
end

-- ========== PHÍM TẮT ==========
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F then
        if State.Flying then
            stopFly()
            if flyConn then flyConn:Disconnect() end
        else
            startFly("Normal")
            startFlyLoop()
        end
    end
end)

