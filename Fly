    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundTransparency = 1
    b.Text = ""
    b.AutoButtonColor = false
    b.Parent = f
    
    local iconLbl = Instance.new("TextLabel")
    iconLbl.Size = UDim2.new(0, 40, 0, 45)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text = icon or "✈️"
    iconLbl.TextColor3 = Color3.new(1, 1, 1)
    iconLbl.TextSize = 22
    iconLbl.Font = Enum.Font.GothamBold
    iconLbl.Parent = f
    
    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, -45, 1, 0)
    nameLbl.Position = UDim2.new(0, 42, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = name
    nameLbl.TextColor3 = Color3.new(1, 1, 1)
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 11
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.Parent = f
    
    b.MouseButton1Click:Connect(function()
        if State.Flying and State.Mode == mode then
            stopFly()
            if flyConn then flyConn:Disconnect() end
            f.BackgroundColor3 = color
        else
            stopFly()
            if flyConn then flyConn:Disconnect() end
            startFly(mode)
            startFlyLoop()
            for _, btn in pairs(allBtns) do
                btn.frame.BackgroundColor3 = btn.color
            end
            f.BackgroundColor3 = Color3.fromRGB(80, 80, 180)
        end
    end)
    
    table.insert(allBtns, {frame = f, btn = b, color = color})
    return b
end

