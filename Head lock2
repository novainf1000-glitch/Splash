--[[ LOOK AT PLAYER - HỖ TRỢ ANIMATIONCONSTRAINT ]]
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer

local Config = {
    LookMode = 0,
    LockedTarget = nil,
    MaxDistance = 1500,
    MaxYaw = 200,
    MaxPitch = 100,
}

local currentNeck = nil
local baseC0 = nil
local baseTransform = nil
local neckType = nil

local function findNeck(character)
    if not character then return nil, nil end
    local head = character:FindFirstChild("Head")
    if head then
        local n = head:FindFirstChild("Neck")
        if n then
            if n:IsA("AnimationConstraint") then
                return n, "AnimationConstraint"
            elseif n:IsA("Motor6D") then
                return n, "Motor6D"
            end
        end
    end
    local upperTorso = character:FindFirstChild("UpperTorso")
    if upperTorso then
        local n = upperTorso:FindFirstChild("Neck")
        if n and n:IsA("Motor6D") then return n, "Motor6D" end
    end
    local torso = character:FindFirstChild("Torso")
    if torso then
        local n = torso:FindFirstChild("Neck")
        if n and n:IsA("Motor6D") then return n, "Motor6D" end
    end
    return nil, nil
end

local function setupNeck()
    local c = player.Character
    if not c then return end
    local neck, ntype = findNeck(c)
    if neck and neck ~= currentNeck then
        currentNeck = neck
        neckType = ntype
        if ntype == "Motor6D" then
            baseC0 = neck.C0
            print("✅ Setup Neck: Motor6D | C0:", baseC0)
        else
            baseTransform = neck.Transform
            print("✅ Setup Neck: AnimationConstraint | Transform:", baseTransform)
        end
    end
end

setupNeck()
player.CharacterAdded:Connect(function()
    task.wait(0.5)
    currentNeck = nil
    baseC0 = nil
    baseTransform = nil
    setupNeck()
end)

local function getClosestPlayer()
    local closest = nil
    local minDist = math.huge
    local myChar = player.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local otherRoot = other.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = other.Character:FindFirstChildOfClass("Humanoid")
            if otherRoot and otherHum and otherHum.Health > 0 then
                local dist = (otherRoot.Position - myRoot.Position).Magnitude
                if dist < minDist and dist <= Config.MaxDistance then
                    minDist = dist
                    closest = other
                end
            end
        end
    end
    return closest
end

local lookConn = nil

local function startLook()
    if lookConn then lookConn:Disconnect() end
    lookConn = RunService.RenderStepped:Connect(function()
        if Config.LookMode == 0 then return end
        if not currentNeck then
            setupNeck()
            return
        end
        
        local target = nil
        if Config.LookMode == 1 then
            target = getClosestPlayer()
        elseif Config.LookMode == 2 then
            target = Config.LockedTarget
            if not target or not target.Character then
                target = getClosestPlayer()
                Config.LockedTarget = target
            end
        end
        if not target then return end
        
        local myChar = player.Character
        if not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local targetChar = target.Character
        if not targetChar then return end
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end
        
        local relative = myRoot.CFrame:PointToObjectSpace(targetRoot.Position)
        local yaw = math.atan2(-relative.X, -relative.Z)
        local flatDist = math.sqrt(relative.X^2 + relative.Z^2)
        local pitch = math.atan2(relative.Y, flatDist)
        
        local maxYaw = math.rad(Config.MaxYaw)
        local maxPitch = math.rad(Config.MaxPitch)
        yaw = math.clamp(yaw, -maxYaw, maxYaw)
        pitch = math.clamp(pitch, -maxPitch, maxPitch)
        
        -- ✅ SỬA: tùy loại Neck
        local offset = CFrame.Angles(pitch, yaw, 0)
        if neckType == "AnimationConstraint" then
            currentNeck.Transform = offset
        else
            currentNeck.C0 = baseC0 * offset
        end
    end)
end

local function stopLook()
    if lookConn then lookConn:Disconnect() lookConn = nil end
    if currentNeck then
        pcall(function()
            if neckType == "AnimationConstraint" then
                currentNeck.Transform = CFrame.new()
            else
                currentNeck.C0 = baseC0
            end
        end)
    end
end

local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = 1.5
        })
    end)
end

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.One then
        if Config.LookMode == 1 then
            Config.LookMode = 0
            stopLook()
            notify("👁️", "Auto Look OFF")
        else
            Config.LookMode = 1
            Config.LockedTarget = nil
            startLook()
            notify("👁️", "Auto Look ON")
        end
    end
    if input.KeyCode == Enum.KeyCode.Two then
        if Config.LookMode == 2 then
            Config.LookMode = 0
            stopLook()
            notify("🔒", "Lock OFF")
        else
            local t = getClosestPlayer()
            if t then
                Config.LookMode = 2
                Config.LockedTarget = t
                startLook()
                notify("🔒", "Lock: " .. t.Name)
            else
                notify("🔒", "Không có ai")
            end
        end
    end
end)

