
-- AUTO LOOK + LOCK TARGET (R15)
-- Nút 1: Bật/tắt nhìn người gần nhất
-- Chạm một người 2 lần (không cần liên tiếp): khóa mục tiêu
-- Nút 0: Tắt hoàn toàn

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

local mode = 0
local lockedTarget = nil
local selectedTarget = nil
local clickCounts = {}
local neck, originalC0
local connection

local gui = Instance.new("ScreenGui")
gui.Name = "AutoLookR15"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local function makeButton(text, pos)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(115, 45)
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextScaled = true
    b.Text = text
    b.Parent = gui
    return b
end

local autoBtn = makeButton("1 | AUTO", UDim2.new(0, 20, 0.55, 0))
local offBtn = makeButton("0 | OFF", UDim2.new(0, 20, 0.55, 50))
local status = Instance.new("TextLabel")
status.Size = UDim2.fromOffset(230, 35)
status.Position = UDim2.new(0, 20, 0.55, 100)
status.BackgroundTransparency = 0.25
status.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
status.TextColor3 = Color3.new(1, 1, 1)
status.TextScaled = true
status.Text = "Auto Look: OFF"
status.Parent = gui

local function setupCharacter(char)
    neck = nil
    originalC0 = nil
    local upper = char:WaitForChild("UpperTorso", 5)
    if upper then
        neck = upper:FindFirstChild("Neck")
        if neck and neck:IsA("Motor6D") then
            originalC0 = neck.C0
        end
    end
end

if player.Character then setupCharacter(player.Character) end
player.CharacterAdded:Connect(setupCharacter)

local function valid(p)
    if not p or p == player or not p.Character then return false end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
        and p.Character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function closestPlayer()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local best, distance = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if valid(p) then
            local targetRoot = p.Character.HumanoidRootPart
            local d = (targetRoot.Position - root.Position).Magnitude
            if d < distance then
                best, distance = p, d
            end
        end
    end
    return best
end


local function lookAt(p, dt)
    if not p or not p.Character then return end

    local char = player.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    local upperTorso = char:FindFirstChild("UpperTorso")
    local root = char:FindFirstChild("HumanoidRootPart")
    local targetHead = p.Character:FindFirstChild("Head")

    if not head or not upperTorso or not root or not targetHead then
        return
    end

    local neckJoint = upperTorso:FindFirstChild("Neck")
    if not neckJoint or not neckJoint:IsA("Motor6D") then
        return
    end

    -- Lấy hướng mục tiêu theo hệ tọa độ của thân
    local direction = root.CFrame:VectorToObjectSpace(
        targetHead.Position - head.Position
    )

    local yaw = math.atan2(-direction.X, -direction.Z)
    local pitch = math.atan2(
        direction.Y,
        math.sqrt(direction.X^2 + direction.Z^2)
    )

    yaw = math.clamp(yaw, math.rad(-70), math.rad(70))
    pitch = math.clamp(pitch, math.rad(-30), math.rad(30))

    local baseC0 = neckJoint:GetAttribute("AutoLookBaseC0")
    if not baseC0 then
        baseC0 = neckJoint.C0
        neckJoint:SetAttribute("AutoLookBaseC0", baseC0)
    end

    local targetC0 = baseC0 * CFrame.Angles(pitch, yaw, 0)
    neckJoint.C0 = neckJoint.C0:Lerp(
        targetC0,
        math.clamp(dt * 12, 0, 1)
    )
end
